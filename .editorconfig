# http://editorconfig.org

# This file is the top-most EditorConfig file
root = true

# All Files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
max_line_length = 100

[*.{tf,tfvars}]
indent_style = space
indent_size = 2

# VS insists that csproj files use spaces
[*.csproj]
indent_style = space
indent_size = 2

# Markdown Files
[*.md]
trim_trailing_whitespace = false

[*.html]
indent_style = unset

[{package.json}]
indent_style = space
tab_width = 2
