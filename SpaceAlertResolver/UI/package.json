{
	"name": "space-alert",
	"packageManager": "yarn@4.1.1",
	"engines": {
		"node": ">=20.12.2"
	},
	"type": "module",
	"scripts": {
		"start": "vite",
		"start-tsc": "tsc --watch",
		"lint-ci": "eslint . --report-unused-disable-directives --max-warnings 0",
		"build-local": "tsc && vite build",
		"build-prod": "tsc && vite build --mode prod",
		"prettier-ci": "prettier --check .",
		"prettier-write": "prettier --write .",
		"storybook": "storybook dev -p 9230",
		"build-storybook": "storybook build",
		"build-storybook-ci": "storybook build --quiet --loglevel error",
		"test-storybook": "test-storybook",
		"test-storybook-ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"yarn run build-storybook-ci && npx http-server storybook-static --port 9230 --silent\" \"npx wait-on http://127.0.0.1:9230 && yarn run test-storybook --url http://127.0.0.1:9230\""
	},
	"dependencies": {
		"@emotion/react": "^11.11.4",
		"@emotion/styled": "^11.11.5",
		"@eslint/js": "^9.1.1",
		"@mui/icons-material": "^5.15.15",
		"@mui/material": "^5.15.15",
		"@storybook/addon-actions": "^8.0.10",
		"@storybook/addon-essentials": "^8.0.10",
		"@storybook/blocks": "^8.0.10",
		"@storybook/react": "^8.0.10",
		"@storybook/react-vite": "^8.0.10",
		"@storybook/test-runner": "^0.18.2",
		"@storybook/testing-library": "^0.2.2",
		"@types/eslint": "^8.56.10",
		"@types/prettier": "^3.0.0",
		"@types/react": "^18.3.1",
		"@types/react-dom": "^18.3.0",
		"@typescript-eslint/eslint-plugin": "^7.8.0",
		"@typescript-eslint/parser": "^7.8.0",
		"@vitejs/plugin-react": "^4.2.1",
		"barcode-detector": "^2.2.5",
		"classnames": "^2.3.1",
		"concurrently": "^8.2.2",
		"eslint": "^9.1.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-react-refresh": "^0.4.6",
		"eslint-plugin-storybook": "^0.8.0",
		"globals": "^15.1.0",
		"http-server": "^14.1.1",
		"jest": "^29.7.0",
		"jest-circus": "^29.7.0",
		"jest-environment-node": "^29.7.0",
		"jest-playwright-preset": "^4.0.0",
		"jest-runner": "^29.7.0",
		"msw": "^2.3.0",
		"msw-storybook-addon": "^2.0.2",
		"playwright": "^1.43.1",
		"playwright-chromium": "^1.43.1",
		"prettier": "^3.2.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.23.1",
		"storybook": "^8.0.10",
		"styled-jsx": "^5.1.2",
		"test-storybook": "^1.0.0",
		"typescript": "^5.4.5",
		"typescript-language-server": "^4.3.3",
		"vite": "^5.2.10",
		"vite-tsconfig-paths": "^4.3.2"
	},
	"msw": {
		"workerDirectory": [
			"public",
			"storybook-public"
		]
	}
}
